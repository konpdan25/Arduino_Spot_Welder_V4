      (justify left bottom)
    )
    (uuid 86525849-efa4-580c-9a62-263df9b3aca5)
  )
  (text "                                              +--F102 3A--> J1 control board (hold-up banks, 7805, Nano, interlocks)   6x IRLZ44N"
    (at 20 48.26 0)
    (effects
      (font (size 1.6 1.6))
      (justify left bottom)
    )
    (uuid da4781e9-5465-5745-98c6-05489939e84d)
  )
  (text "                                              +--D101 STPS3045CP (free-wheel, cathode)  <--------- anodes ---------- DRAIN_BUS"
    (at 20 52.07 0)
    (effects
      (font (size 1.6 1.6))
      (justify left bottom)
    )
    (uuid 138470ed-e52b-58d6-9d50-f838b7e55afc)
  )
  (text "  BT1 (-) ==16 mm2== SOURCE bar = GND star point <-- control GND (J1.2, J3.2/J3.6) ------------------------------ sources"
    (at 20 57.15 0)
    (effects
      (font (size 1.6 1.6))
      (justify left bottom)
    )
    (uuid c611198c-a91a-5ca5-ab42-734967d8cab5)
  )
