  )
  (text "  BT1 RT1270 (+) --F101 ANL--S101 DISCONNECT--+ P_BUS --K101 relay (carry-only)-- ELECTRODE+ ~~ workpiece ~~ ELECTRODE- --+ DRAIN_BUS"
    (at 20 39.37 0)
    (effects
      (font (size 1.6 1.6))
      (justify left bottom)
    )
    (uuid 0b496f42-2797-5708-962f-9c2afd31dfae)
  )
