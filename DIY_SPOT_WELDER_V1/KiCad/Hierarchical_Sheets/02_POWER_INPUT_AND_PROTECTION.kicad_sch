    (effects
      (font (size 1.5 1.5))
      (justify left bottom)
    )
    (uuid cae99f0f-97b9-5c7a-a553-f7b22febbefc)
  )
  (text "U2 7805 -> +5V_AUX (hardware references, HCT14, LEDs, buzzer). U6 MCP1700 -> +3V3 (OLED, MCP9804, I2C)."
